<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when signing with a Developer ID (hardened runtime, needed for notarization).
     libgphoto2 opens its camera drivers with dlopen at run time; library validation would
     refuse any of them not signed by the same team. Not sandboxed: the app needs the USB
     camera, the serial port of the Scanlight and arbitrary roll folders. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
